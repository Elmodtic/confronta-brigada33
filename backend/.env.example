# Configuración del backend — copia este archivo como ".env" y ajusta
# Puerto de la API
PORT=3000

# Conexión a MySQL (XAMPP por defecto usa root sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=confronta_brigada

# Clave secreta para firmar los tokens JWT (CÁMBIALA por algo largo y aleatorio)
JWT_SECRET=cambia_esta_clave_por_una_muy_larga_y_secreta
JWT_EXPIRES=8h

# Orígenes permitidos por CORS (separados por coma si son varios).
# En desarrollo local puedes dejarlo abierto; en producción restringe al
# dominio real de la app/panel.
CORS_ORIGINS=*
