<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tienes dos saldos distintos y no se mezclan: uno es tuyo como comensal, el otro es el fondo operativo del rancho."
            android:textColor="@color/texto_secundario" android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- Fondo del rancho -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="14dp" app:cardElevation="3dp"
            app:cardBackgroundColor="@color/verde_militar">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Fondo del rancho (para cocinar)"
                    android:textColor="@color/blanco" android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvFondo"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/blanco"
                    android:textSize="32sp" android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvFondoDetalle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/blanco" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Saldo como comensal -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp" app:cardElevation="2dp"
            app:cardBackgroundColor="@color/superficie">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Mi saldo como comensal (para comer)"
                    android:textColor="@color/texto_secundario" android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvSaldoComensal"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/verde_militar_oscuro"
                    android:textSize="26sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Confirmacion de entregas por QR -->
        <TextView
            android:id="@+id/tvPorConfirmar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/rojo_novedad" android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEscanear"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:paddingVertical="16dp"
            android:text="Escanear QR del tesorero"
            android:textSize="15sp" app:cornerRadius="12dp" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="o ingresa el código manualmente"
            android:gravity="center"
            android:textColor="@color/texto_secundario" android:textSize="13sp"
            android:layout_marginTop="10dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:hint="Código del QR">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCodigo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="text" android:maxLength="32" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:paddingVertical="14dp"
            android:text="Confirmar recepción" app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFecha"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:paddingVertical="12dp"
            android:text="Fecha" app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/tvTituloPeriodo"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Recibido" android:textStyle="bold" android:textSize="16sp"
            android:textColor="@color/verde_militar_oscuro" android:layout_marginTop="16dp" />
        <LinearLayout
            android:id="@+id/contenedorPeriodo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Entregas recibidas" android:textStyle="bold" android:textSize="16sp"
            android:textColor="@color/verde_militar_oscuro" android:layout_marginTop="22dp" />
        <LinearLayout
            android:id="@+id/contenedorMovimientos"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
