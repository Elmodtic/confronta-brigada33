<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Precio de cada ración (en dólares)"
            android:textStyle="bold" android:textColor="@color/verde_militar_oscuro"
            android:textSize="16sp" android:layout_marginBottom="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Desayuno">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDesayuno"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:hint="Almuerzo">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAlmuerzo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:hint="Merienda">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMerienda"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:paddingVertical="12dp"
            android:text="Guardar precios" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Al guardar, los nuevos precios aplican desde hoy. El historial anterior conserva sus precios."
            android:textColor="@color/gris_texto" android:textSize="12sp"
            android:layout_marginTop="12dp" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
