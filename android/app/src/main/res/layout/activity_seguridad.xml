<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Estado actual -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="14dp" app:cardElevation="2dp"
            app:cardBackgroundColor="@color/verde_militar">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Consultando..." android:textColor="@color/blanco"
                    android:textSize="18sp" android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvDetalle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="" android:textColor="@color/blanco" android:textSize="13sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvObligatorio"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Es obligatoria para todas las cuentas. Hasta que la actives no podrás usar el resto de la aplicación."
            android:textColor="@color/verde_militar_oscuro" android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" android:visibility="gone" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Con la verificación en dos pasos, tu contraseña sola no basta para entrar: además hay que escribir un código de 6 dígitos que cambia cada 30 segundos en tu teléfono. Si alguien te roba la clave, igual no puede ingresar."
            android:textColor="@color/texto_secundario" android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <!-- ================= INSCRIPCIÓN ================= -->
        <LinearLayout
            android:id="@+id/panelInscripcion"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="1. Escanea este código"
                android:textStyle="bold" android:textColor="@color/verde_militar_oscuro"
                android:textSize="16sp" android:layout_marginTop="20dp" />
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Ábrelo desde Google Authenticator, Microsoft Authenticator o cualquier app de autenticación."
                android:textColor="@color/texto_secundario" android:textSize="13sp" />

            <ImageView
                android:id="@+id/imgQr"
                android:layout_width="260dp" android:layout_height="260dp"
                android:layout_gravity="center" android:layout_marginTop="12dp"
                android:contentDescription="Código QR de inscripción"
                android:background="@color/blanco" android:padding="8dp" />

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="¿No puedes escanear? Escribe esta clave a mano en la app:"
                android:textColor="@color/texto_secundario" android:textSize="13sp"
                android:layout_marginTop="14dp" />
            <TextView
                android:id="@+id/tvSecreto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textIsSelectable="true"
                android:fontFamily="monospace" android:textSize="15sp"
                android:textColor="@color/texto_principal"
                android:background="@color/blanco" android:padding="12dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="2. Escribe el código que aparece"
                android:textStyle="bold" android:textColor="@color/verde_militar_oscuro"
                android:textSize="16sp" android:layout_marginTop="20dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Código de 6 dígitos">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCodigo"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:maxLength="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActivar"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Activar verificación en dos pasos" />
        </LinearLayout>

        <!-- ================= BOTONES ================= -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmpezar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:visibility="gone"
            android:text="🔐  Activar verificación en dos pasos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNuevosRespaldos"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:visibility="gone"
            android:text="🗝️  Generar códigos de respaldo nuevos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDesactivar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:visibility="gone"
            android:text="Desactivar" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
