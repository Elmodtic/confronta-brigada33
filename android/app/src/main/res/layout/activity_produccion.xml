<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Navegación de fecha -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiaAnterior"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="◀" android:minWidth="48dp" />
            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:text="Fecha" android:textStyle="bold" android:textSize="17sp"
                android:textColor="@color/verde_militar_oscuro" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiaSiguiente"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="▶" android:minWidth="48dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Platos a preparar" android:textStyle="bold"
            android:textColor="@color/verde_militar_oscuro" android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <!-- Totales grandes -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="6dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/verde_militar">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp" android:gravity="center">
                    <TextView android:id="@+id/tvDesayunos" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textColor="@color/blanco" android:textSize="30sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Desayunos" android:textColor="@color/blanco" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginHorizontal="3dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/verde_militar">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp" android:gravity="center">
                    <TextView android:id="@+id/tvAlmuerzos" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textColor="@color/blanco" android:textSize="30sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Almuerzos" android:textColor="@color/blanco" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="6dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp"
                app:cardBackgroundColor="@color/verde_militar">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp" android:gravity="center">
                    <TextView android:id="@+id/tvMeriendas" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textColor="@color/blanco" android:textSize="30sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Meriendas" android:textColor="@color/blanco" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPersonas"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Personas registradas: 0" android:gravity="center"
            android:textColor="@color/gris_texto" android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Desglose por unidad" android:textStyle="bold"
            android:textColor="@color/verde_militar_oscuro"
            android:layout_marginTop="18dp" android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/contenedorUnidades"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="No hay confrontas registradas para esta fecha."
            android:textColor="@color/gris_texto" android:padding="12dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExcel"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="📊  Exportar a Excel" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
