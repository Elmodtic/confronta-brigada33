<?xml version="1.0" encoding="utf-8"?>
<!--
  Seguridad de red.

  El tráfico en texto plano sigue PROHIBIDO en toda la app.

  Ahora hay dos formas de llegar al servidor y cada una necesita una
  confianza distinta:

   1. Por el túnel de Cloudflare (uso normal, desde cualquier red):
      el certificado lo emite una autoridad pública reconocida, así que
      basta con las CA del sistema.

   2. Por la red local (pruebas en la misma WiFi o anclaje USB):
      el certificado es autofirmado, por eso esas direcciones concretas
      también confían en confronta_ca.

  Si el túnel cambia de dirección NO hace falta tocar este archivo:
  cualquier host público con certificado válido funciona. La dirección
  se cambia desde la pantalla de inicio de sesión.
-->
<network-security-config>

    <!-- Regla general: HTTPS obligatorio, confianza en las CA del sistema -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Excepción para el servidor local con certificado autofirmado -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">10.215.110.48</domain>
        <domain includeSubdomains="false">10.20.91.170</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">confronta.local</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/confronta_ca" />
        </trust-anchors>
    </domain-config>

</network-security-config>
